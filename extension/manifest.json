{
  "manifest_version": 3,
  "name": "weirdhost Presence Bridge",
  "version": "0.1.8",
  "description": "weirdhost 페이지 상태를 weirdhost Presence 앱에 전달합니다.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*.weirdhost.xyz/*",
    "https://weirdhost.xyz/*",
    "http://127.0.0.1:32145/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.weirdhost.xyz/*",
        "https://weirdhost.xyz/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "weirdhost Presence",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
